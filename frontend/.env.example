# WATT WATCHER — Frontend environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# Base URL of the dataviz API (FastAPI, api/).
# Default '/api' works with the Caddy path-routing setup on the VPS
# and with the Vite dev proxy (see vite.config.js).
VITE_API_BASE_URL=/api
