# WATT_WATCHER — Terraform Variables
# Copy this file to terraform.tfvars and fill in your values.

location = "francecentral"

# Supabase PostgreSQL connection string — injected into the Function App
# as SUPABASE_CONNECTION_STRING (pipeline writes Gold data here).
supabase_connection_string = "postgresql://postgres:CHANGE_ME@db.xxxxx.supabase.co:5432/postgres"

# Data retention (days)
retention_bronze_days = 180   # 6 months
retention_silver_days = 90    # 3 months
retention_audit_days  = 365   # 12 months
price_retention_days  = 7     # 1 week — FACT_MARKET_PRICE only, purged daily

# ENTSO-E Transparency Platform token — day-ahead market price ingestion.
# Optional: leave empty ("") to skip price ingestion entirely (non-fatal).
# Get one at https://transparency.entsoe.eu/ (see docs/entsoe_price_integration_report.md).
entsoe_api_token = ""
