# Copy to .env on the VPS — read automatically by docker-compose.yml.
# Also usable for local api/ dev (uvicorn api.main:app --reload).

SUPABASE_CONNECTION_STRING=postgresql://postgres:CHANGE_ME@db.xxxxx.supabase.co:5432/postgres

# Comma-separated list of allowed origins for the FastAPI CORS middleware.
# Not required when Caddy proxies both /api and the frontend under the same
# origin (watt-watcher.dvdjnbr.fr) — same-origin requests don't need CORS.
CORS_ALLOW_ORIGINS=*
